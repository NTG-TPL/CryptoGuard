{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "GCC: Build Debug",
            "type": "shell",
            "command": [
                "mkdir ${workspaceFolder}/build ; ",
                "cd ${workspaceFolder}/build &&",
                "conan build -b missing -s build_type=Debug .."
            ],
            "presentation": {
                "clear": true
            },
            "hide": false,
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "GCC: Build Release",
            "type": "shell",
            "command": [
                "mkdir ${workspaceFolder}/build ; ",
                "cd ${workspaceFolder}/build &&",
                "conan build -b missing -s build_type=Release .."
            ],
            "presentation": {
                "clear": true
            },
            "hide": false,
            "group": {
                "kind": "build"
            }
        },
        {
            "label": "Lint: clang-format + clang-tidy",
            "type": "shell",
            "command": "clang-format --dry-run --Werror ${workspaceFolder}/include/*.h ${workspaceFolder}/src/*.h ${workspaceFolder}/src/*.cpp ${workspaceFolder}/tests/*.cpp && clang-tidy-20 -p ${workspaceFolder}/build --quiet --header-filter='^${workspaceFolder}/(include|src|tests)/' ${workspaceFolder}/src/*.cpp ${workspaceFolder}/tests/*.cpp",
            "presentation": {
                "clear": true
            },
            "problemMatcher": "$gcc"
        }
    ]
}
